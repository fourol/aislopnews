# Telegram Bot Configuration
# Создайте бота через @BotFather и получите токен
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"

# ID или юзернейм вашего канала (канал должен быть публичным с @channel_name или приватным с -100xxxxxxxxxx)
# Бот ОБЯЗАТЕЛЬНО должен быть добавлен в администраторы канала с правом публикации сообщений!
TELEGRAM_CHANNEL_ID="@your_channel_name"

# LLM API Configuration
# Ключ к любому OpenAI-совместимому API (OpenAI, DeepSeek, OpenRouter, Groq, Ollama)
LLM_API_KEY="sk-..."

# URL сервиса:
# Для OpenAI: https://api.openai.com/v1
# Для DeepSeek: https://api.deepseek.com
# Для OpenRouter: https://openrouter.ai/api/v1
# Для Groq: https://api.groq.com/openai/v1
# Для локальной Ollama: http://localhost:11434/v1
LLM_BASE_URL="https://api.openai.com/v1"

# Модель (например gpt-4o-mini, deepseek-chat, mistralai/mistral-large, llama3)
LLM_MODEL="gpt-4o-mini"
